{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    // Typecheck-only project: composite declaration emit would demand
    // exportable types from modules that are inlined into the binary.
    "composite": false,
    // baseUrl needed until resolver fix propagates to system Bun used during build
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "internal/*": ["./internal/*"] //deprecated
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "./builtins.d.ts", "./private.d.ts"]
}

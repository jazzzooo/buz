diff --git a/src/lib/include/ares_llist.h b/src/lib/include/ares_llist.h
--- a/src/lib/include/ares_llist.h
+++ b/src/lib/include/ares_llist.h
@@ -199,3 +199,8 @@
 CARES_EXTERN void              *ares_llist_node_claim(ares_llist_node_t *node);
 
+/* Claims the entries present on entry, without allocating. Callback additions
+ * remain in list; consume owns each claimed value. */
+CARES_EXTERN void ares_llist_claim_all(ares_llist_t *list,
+                                     ares_llist_destructor_t consume);
+
 /*! Replace user-supplied value for node
diff --git a/src/lib/dsa/ares_llist.c b/src/lib/dsa/ares_llist.c
--- a/src/lib/dsa/ares_llist.c
+++ b/src/lib/dsa/ares_llist.c
@@ -380,3 +380,26 @@
   ares_llist_node_detach(node);
   ares_llist_attach_at(new_parent, ARES__LLIST_INSERT_HEAD, NULL, node);
 }
+
+void ares_llist_claim_all(ares_llist_t *list,
+                          ares_llist_destructor_t consume)
+{
+  ares_llist_t detached;
+  ares_llist_node_t *node;
+
+  if (list == NULL || consume == NULL) {
+    return;
+  }
+
+  detached = *list;
+  list->head = NULL;
+  list->tail = NULL;
+  list->cnt = 0;
+  for (node = detached.head; node != NULL; node = node->next) {
+    node->parent = &detached;
+  }
+
+  while ((node = ares_llist_node_first(&detached)) != NULL) {
+    consume(ares_llist_node_claim(node));
+  }
+}
